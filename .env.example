# Frontend
# Base URL for the API (unused in the mock/demo build)
REACT_APP_BACKEND_URL=https://your-backend-url.com

# --- Integration placeholders (swap in real keys when going live) ---
# Firebase Authentication
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id

# Supabase
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Payments (South Africa)
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_xxx
REACT_APP_PAYFAST_MERCHANT_ID=your_payfast_merchant_id
REACT_APP_OZOW_SITE_CODE=your_ozow_site_code
